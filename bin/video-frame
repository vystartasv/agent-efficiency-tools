#!/usr/bin/env python3
"""Extract one video frame to a new PNG using FFmpeg."""
import argparse
from decimal import Decimal, InvalidOperation
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import re

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('input', help='local video file')
parser.add_argument('output', help='new PNG output file')
parser.add_argument('seconds', help='nonnegative timestamp in seconds')
args = parser.parse_args()
try:
    seconds = Decimal(args.seconds)
    if not seconds.is_finite() or seconds < 0 or seconds > 1000000000 or not -9 <= seconds.as_tuple().exponent <= 9:
        raise InvalidOperation
except InvalidOperation:
    parser.error('seconds must be finite, between 0 and 1000000000, with at most 9 decimal places')
source, output = Path(args.input), Path(args.output)
if not source.is_file():
    parser.error('input must be an existing local file')
if output.suffix.lower() != '.png':
    parser.error('output must end in .png')
try:
    with tempfile.TemporaryDirectory(prefix='.video-frame-', dir=output.parent) as directory:
        temp = Path(directory) / 'frame.png'
        command = ['ffmpeg', '-nostdin', '-hide_banner', '-loglevel', 'info', '-protocol_whitelist', 'file,pipe',
                   '-i', str(source.resolve()), '-map', '0:v:0',
                   '-vf', f"select='gte(t,{format(seconds, 'f')})',showinfo",
                   '-frames:v', '1', '-update', '1', '-f', 'image2', str(temp)]
        result = subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        if result.returncode != 0:
            print(f'video-frame: ffmpeg failed: {result.stderr.strip()}', file=sys.stderr)
            sys.exit(1)
        if not temp.is_file() or temp.stat().st_size == 0:
            print('video-frame: no frame found at or after the requested timestamp', file=sys.stderr)
            sys.exit(1)
        match = re.search(r'showinfo[^\n]*\bn:\s*0\s+pts:\s*\S+\s+pts_time:\s*(\S+)', result.stderr)
        try:
            frame_time = float(match.group(1)) if match else None
            if frame_time is not None and not math.isfinite(frame_time):
                frame_time = None
        except ValueError:
            frame_time = None
        os.link(temp, output)
        print(json.dumps({'input': args.input, 'output': args.output, 'requested_seconds': str(seconds),
                          'frame_time_seconds': frame_time}))
except OSError as exc:
    print(f'video-frame: {exc}', file=sys.stderr)
    sys.exit(1)
