#!/usr/bin/env python3
"""Extract bounded diagnostic lines from a potentially large text log."""
import argparse
from collections import deque
import json
from pathlib import Path
import re
import sys

DEFAULT_PATTERN = r"(?i)(?:\b(error|errors|fail(?:ed|ure|ures)?|exception|traceback|fatal|panic|not ok)\b|[A-Za-z]+Error\b)"


def main():
    parser = argparse.ArgumentParser(
        prog="agent-tools log-scan",
        description="Scan a log and return bounded matching lines with line numbers and context."
    )
    parser.add_argument("input", type=Path)
    parser.add_argument("--pattern", default=DEFAULT_PATTERN,
                        help="regular expression to select diagnostic lines (default: common failure words)")
    parser.add_argument("--context", type=int, default=2, help="lines around each match (default: 2; max: 10)")
    parser.add_argument("--max-matches", type=int, default=20, help="maximum matching lines returned (default: 20; max: 200)")
    parser.add_argument("--max-line-chars", type=int, default=2000, help="maximum characters per returned line (default: 2000; max: 10000)")
    args = parser.parse_args()
    if not 0 <= args.context <= 10:
        parser.error("--context must be between 0 and 10")
    if not 1 <= args.max_matches <= 200:
        parser.error("--max-matches must be between 1 and 200")
    if not 1 <= args.max_line_chars <= 10000:
        parser.error("--max-line-chars must be between 1 and 10000")
    try:
        pattern = re.compile(args.pattern)
    except re.error as error:
        parser.error(f"invalid --pattern: {error}")

    try:
        with args.input.open("r", encoding="utf-8", errors="replace") as stream:
            before = deque(maxlen=args.context)
            selected = []
            match_count = 0
            line_count = 0
            context_after = 0
            for number, raw in enumerate(stream, 1):
                line_count = number
                line = raw.rstrip("\r\n")
                match = pattern.search(line) is not None
                if match:
                    match_count += 1
                    if match_count <= args.max_matches:
                        selected.extend({"line": n, "kind": "context", "text": value}
                                        for n, value in before)
                        selected.append({"line": number, "kind": "match", "text": line})
                        context_after = args.context
                    else:
                        context_after = 0
                elif context_after:
                    selected.append({"line": number, "kind": "context", "text": line})
                    context_after -= 1
                before.append((number, line))
    except OSError as error:
        print(f"log-scan: {error}", file=sys.stderr)
        return 2

    # Merge overlapping context and keep it bounded by matching-line count.
    selected.sort(key=lambda item: item["line"])
    merged = []
    seen = set()
    for item in selected:
        if item["line"] in seen:
            if item["kind"] == "match":
                for existing in merged:
                    if existing["line"] == item["line"]:
                        existing["kind"] = "match"
                        break
            continue
        seen.add(item["line"])
        merged.append(item)
    lines = []
    truncated_lines = 0
    for item in merged:
        value = item["text"]
        if len(value) > args.max_line_chars:
            value = value[:args.max_line_chars]
            truncated_lines += 1
        lines.append({**item, "text": value})
    result = {
        "source": str(args.input),
        "lines_scanned": line_count,
        "match_count": match_count,
        "matches_returned": sum(item["kind"] == "match" for item in lines),
        "matches_truncated": match_count > args.max_matches,
        "line_text_truncated": truncated_lines > 0,
        "context_lines": args.context,
        "lines": lines,
    }
    print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
    return 1 if match_count else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(1)
