#!/usr/bin/env python3
"""Prepare image copies in one pass and report their byte sizes as JSON."""
import argparse
import json
from pathlib import Path
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(
        prog="agent-tools image-batch",
        description="Create resized image copies without replacing inputs; report byte savings as JSON."
    )
    parser.add_argument("output_dir", type=Path)
    parser.add_argument("images", nargs="+")
    parser.add_argument("--max-dimension", type=int, default=1600)
    parser.add_argument("--format", choices=("png", "jpeg"), default="png")
    parser.add_argument("--quality", type=int, help="JPEG quality from 1 to 100")
    args = parser.parse_args()
    if not 1 <= args.max_dimension <= 100000:
        parser.error("--max-dimension must be between 1 and 100000")
    if args.quality is not None and not 1 <= args.quality <= 100:
        parser.error("--quality must be between 1 and 100")
    if args.quality is not None and args.format != "jpeg":
        parser.error("--quality is only valid with --format jpeg")

    sources = [Path(value) for value in args.images]
    missing = [str(path) for path in sources if not path.is_file()]
    if missing:
        parser.error("input files not found: " + ", ".join(missing))
    suffix = ".jpg" if args.format == "jpeg" else ".png"
    outputs = [args.output_dir / (path.stem + suffix) for path in sources]
    if len(set(outputs)) != len(outputs):
        parser.error("input names collide in the output directory")
    existing = [str(path) for path in outputs if path.exists() or path.is_symlink()]
    if existing:
        parser.error("output files already exist: " + ", ".join(existing))
    tool = Path(__file__).with_name("image-prepare")
    args.output_dir.mkdir(parents=True, exist_ok=True)

    results = []
    failed = False
    for source, output in zip(sources, outputs):
        before = source.stat().st_size
        command = [str(tool), str(source), str(output), str(args.max_dimension)]
        if args.quality is not None:
            command.append(str(args.quality))
        run = subprocess.run(command, capture_output=True, text=True)
        if run.returncode:
            failed = True
            results.append({"source": str(source), "output": str(output), "error": run.stderr.strip()})
            continue
        after = output.stat().st_size
        results.append({
            "source": str(source), "output": str(output), "source_bytes": before,
            "output_bytes": after, "bytes_saved": before - after,
            "fraction_saved": (before - after) / before if before else 0,
        })
    print(json.dumps({"results": results, "failed": failed}, separators=(",", ":")))
    return 1 if failed else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except OSError as error:
        print(f"image-batch: {error}", file=sys.stderr)
        sys.exit(2)
