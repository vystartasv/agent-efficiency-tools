#!/usr/bin/env python3
"""Inspect selected metadata from a local media file using FFprobe."""
import argparse
import json
from pathlib import Path
import subprocess
import sys

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('input', help='local media file')
args = parser.parse_args()
source = Path(args.input)
if not source.is_file():
    parser.error('input must be an existing local file')
command = ['ffprobe', '-v', 'error', '-protocol_whitelist', 'file,pipe',
           '-show_entries', 'format=format_name,duration,size:stream=index,codec_type,codec_name,width,height,sample_rate,channels,avg_frame_rate,duration',
           '-of', 'json', str(source.resolve())]
try:
    result = subprocess.run(command, capture_output=True, text=True, timeout=30)
    if result.returncode != 0:
        print('media-info: ffprobe failed: ' + result.stderr[-4000:].strip(), file=sys.stderr)
        sys.exit(1)
    data = json.loads(result.stdout)
    streams = data.get('streams', [])
    if not isinstance(streams, list):
        raise ValueError('unexpected stream metadata')
    truncated = len(streams) > 100
    print(json.dumps({'source': args.input, 'format': data.get('format', {}), 'streams': streams[:100],
                      'stream_count': len(streams), 'truncated': truncated}))
    sys.exit(1 if truncated else 0)
except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
    print(f'media-info: {exc}', file=sys.stderr)
    sys.exit(2)
